# Database Configuration
POSTGRES_DB=online_pos_system
POSTGRES_USER=pos_app
POSTGRES_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/online_pos_system
SPRING_DATASOURCE_USERNAME=pos_runtime
SPRING_DATASOURCE_PASSWORD=

# Server Configuration
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443
SPRING_PROFILES_ACTIVE=default
RUN_MIGRATION_SQL=true

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# JWT Security
JWT_SECRET=
SESSION_COOKIE_SECURE=true
APP_BASE_URL=https://email.crowdcam.co.za

# Password Reset Email Configuration
# A sending_access key is sufficient. MAIL_API remains a legacy fallback.
RESEND_API_KEY=
MAIL_API=
RESEND_FROM_EMAIL=noreply@email.crowdcam.co.za

# TLS Certificate Registration
CERTBOT_EMAIL=

# Google Maps API Key
GOOGLE_MAPS_API_KEY=

# Separate migration owner. Never use the bootstrap POSTGRES_USER for normal queries.
MIGRATION_DATASOURCE_URL=jdbc:postgresql://db:5432/online_pos_system
MIGRATION_DATASOURCE_USERNAME=pos_owner
MIGRATION_DATASOURCE_PASSWORD=
RLS_RUNTIME_ROLE=pos_runtime
