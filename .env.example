# Database Configuration
POSTGRES_DB=online_pos_system
POSTGRES_USER=pos_app
POSTGRES_PASSWORD=pos_password
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/online_pos_system
SPRING_DATASOURCE_USERNAME=pos_app
SPRING_DATASOURCE_PASSWORD=pos_password

# Server Configuration
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080
HTTP_PORT=80
SPRING_PROFILES_ACTIVE=default
RUN_MIGRATION_SQL=true

# Admin Credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=

# JWT Security
JWT_SECRET=
SESSION_COOKIE_SECURE=false
APP_BASE_URL=http://localhost

# Password Reset Email Configuration
# Prefer RESEND_API_KEY. MAIL_API is kept as a legacy fallback.
RESEND_API_KEY=
MAIL_API=
RESEND_FROM_EMAIL=noreply@your-verified-domain.com
RESEND_ENDPOINT=https://api.resend.com/emails

# Google Maps API Key
GOOGLE_MAPS_API_KEY=
